// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              String         @id @default(cuid())
  slug            String         @unique
  name            String
  tagline         String
  price           Int            // Stored in INR integer (e.g. 1899)
  compareAtPrice  Int?
  category        String
  categoryName    String
  fit             String
  fabric          String
  gsm             Int
  designStory     String
  originNote      String
  details         String[]
  sizes           String[]
  images          String[]
  isNewDrop       Boolean        @default(false)
  isBestseller    Boolean        @default(false)
  inStock         Boolean        @default(true)
  stockCount      Json           // Record<string, number>
  rating          Float          @default(5.0)
  reviewCount     Int            @default(0)
  careInstructions String[]
  variants        ProductVariant[]
  reviews         Review[]
  orderItems      OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName  String
  colorHex   String
  size       String
  stock      Int      @default(10)
  sku        String   @unique
}

model Review {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  author        String
  rating        Int
  title         String
  comment       String
  verified      Boolean  @default(true)
  fitFeedback   String
  heightWeight  String?
  purchasedSize String?
  createdAt     DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   Json        // Address object
  paymentMethod     String      // "razorpay" | "cod" | "stripe"
  paymentStatus     String      // "paid" | "pending_cod" | "failed"
  orderStatus       String      // "confirmed" | "fabric_prep" | "quality_check" | "shipped" | "out_for_delivery" | "delivered"
  subtotal          Int
  shippingFee       Int         @default(0)
  discount          Int         @default(0)
  total             Int
  couponCode        String?
  trackingNumber    String?
  carrier           String?     @default("Bluedart Express")
  estimatedDelivery DateTime
  razorpayOrderId   String?
  razorpayPaymentId String?
  stripeSessionId   String?
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  price       Int
  image       String
  size        String
  color       String
  quantity    Int
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  discountType    String   // "percentage" | "fixed"
  discountValue   Int
  minOrderAmount  Int      @default(0)
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model AbandonedCart {
  id          String   @id @default(cuid())
  email       String?
  phone       String?
  items       Json     // Cart items
  cartTotal   Int
  reminded    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
